NEXT_PUBLIC_APP_NAME=MediVault

# Required for MongoDB-only auth, cloud vault, lab dashboard, original file storage, and report sync.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=medivault

# Optional. Used for lab "today" counters and date filters.
APP_TIME_ZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Asia/Kolkata
NEXT_PUBLIC_MEASUREMENT_SYSTEM=metric
NEXT_PUBLIC_DATA_REGION=india
AUTH_TEST_OTP=
ALLOW_TEST_OTP=false

# Optional AI provider for client self-upload analysis. Lab-created reports do not use AI.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# Local/private Ollama vision analysis. Set AI_PROVIDER=ollama to enable.
# Use 127.0.0.1 only when Ollama runs on the same host as this Next.js server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
# Optional token when Ollama is behind an authenticated reverse proxy.
OLLAMA_API_KEY=

# Secure local Ollama worker. Configure the first two on Railway and use the
# same token as MEDIVAULT_WORKER_TOKEN on the Mac running the worker.
LOCAL_ANALYSIS_WORKER_ENABLED=false
LOCAL_ANALYSIS_WORKER_TOKEN=

# Local worker process only.
MEDIVAULT_BASE_URL=https://mr.yogeshaihub.in
MEDIVAULT_WORKER_TOKEN=
WORKER_POLL_INTERVAL_MS=5000
